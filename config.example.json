{
  "_comment": "Multi-route config. Routes are tried in order; a failure that cannot have been billed moves to the next route. 1k/2k share the regular key.",

  "routes": [
    {
      "name": "main",
      "base_url": "https://ai.whyshy.cn",
      "api_keys": {
        "1k": "sk-SET-YOUR-REGULAR-KEY",
        "4k": "sk-SET-YOUR-4K-KEY"
      },
      "generation": "gpt-image-2.5-flare",
      "edit": "gpt-image-2.5-sunburst",
      "generation_4k": "gpt-image-2",
      "edit_4k": "gpt-image-2"
    },
    {
      "name": "backup",
      "base_url": "https://your-backup-gateway.example/v1",
      "api_keys": {
        "1k": "sk-BACKUP-REGULAR-KEY",
        "4k": "sk-BACKUP-4K-KEY"
      },
      "generation": "gpt-image-2.5-flare",
      "edit": "gpt-image-2.5-sunburst",
      "tiers": ["1k", "2k"]
    }
  ],

  "default_resolution": "1k",
  "default_quality": "xhigh",
  "timeout_seconds": 300,
  "async": {
    "mode": "auto",
    "poll_interval_seconds": 5,
    "task_timeout_seconds": 1800
  }
}
